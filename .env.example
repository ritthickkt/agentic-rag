# Copy to .env and fill in. .env is gitignored.
# Only ANTHROPIC_API_KEY is required; every other line below is the default.

ANTHROPIC_API_KEY=sk-ant-...

# ── models ───────────────────────────────────────────────────────────────────
# Used for query rewriting, the benchmark's grader, and the eval judge.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: a stronger model for writing the cited answer. Blank = use the above.
# Answering with citations is a harder task than rewriting a search query, so this
# is the knob to reach for first if answers are weaker than retrieval.
ANSWER_MODEL=

# ── embeddings ───────────────────────────────────────────────────────────────
# local  = sentence-transformers on this machine. Free, offline, private.
# voyage = Voyage API. Better on long/technical text; costs per token, needs
#          VOYAGE_API_KEY and `pip install voyageai`.
# Switching provider invalidates the existing index: the store refuses a mismatch
# rather than return plausible nonsense. Run `python scripts/rag.py reindex`.
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3

# ── ingestion ────────────────────────────────────────────────────────────────
CHUNK_CHARS=1200          # ~300 tokens; must stay under the embedder's limit
CHUNK_OVERLAP=200         # so a fact on a boundary appears whole somewhere
MIN_CHUNK_CHARS=80
MAX_UPLOAD_MB=50

# ── retrieval ────────────────────────────────────────────────────────────────
COLLECTION=documents
TOP_K=8                   # passages handed to the model per hop
CANDIDATE_K=30            # pool pulled from each retriever before fusion
HYBRID=true               # dense + BM25, fused with reciprocal rank fusion
RRF_K=60                  # standard RRF constant; leave alone
MAX_CONTEXT_CHUNKS=14     # hard cap across all hops

# ── agent loop ───────────────────────────────────────────────────────────────
MAX_HOPS=3                # retrieve -> try to answer -> search for what's missing
ANSWER_ON_EXHAUSTED=true  # final hop answers partially rather than abstaining

# ── vector store ─────────────────────────────────────────────────────────────
# Blank = embedded Qdrant in storage/qdrant (one process only: the API *or* the
# CLI, not both). Point at a server to lift that limit:
#   docker run -p 6333:6333 -v $(pwd)/storage/qdrant-server:/qdrant/storage qdrant/qdrant
# QDRANT_URL=http://localhost:6333

# ── benchmark only (not used by the served app) ───────────────────────────────
SEED=42
N_QUESTIONS=600
UNANSWERABLE_FRAC=0.20
TEST_FRAC=0.30
